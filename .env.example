# Environment Configuration for Private Supplier Intelligence Agent
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_ENV=development
APP_PORT=8501
DATABASE_PATH=data/supplier_intelligence.db
EXCEL_PATH=master_catalog.xlsx

# Exchange Rates (PKR Conversion)
# Manual base rates if offline/free fallback
DEFAULT_USD_TO_PKR=280.0
DEFAULT_USDT_TO_PKR=282.5
DEFAULT_EUR_TO_PKR=305.0

# Landed Cost & Profit Settings (Configurable Band)
TARGET_PROFIT_MIN_PKR=400.0
TARGET_PROFIT_MAX_PKR=800.0
PAYMENT_NETWORK_FEE_PCT=0.015
WARRANTY_REPLACEMENT_RESERVE_PCT=0.03

# Freshness & Staleness Policy (Hours)
QUOTE_FRESHNESS_HOURS=48
STALE_THRESHOLD_HOURS=96

# Public Research Crawler Settings
MAX_REQUESTS_PER_MINUTE=20
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Local-only MTProto access. Do not commit these values or share them in chat.
# The crawler remains disabled until ALLOW_TELETHON_USER_SESSION=1 is set.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ALLOW_TELETHON_USER_SESSION=0
